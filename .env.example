# Copy to .env and fill real values. NEVER commit .env
GROQ_API_KEY=
PLANNER_MODEL=openai/gpt-oss-120b
PLANNER_FALLBACK=qwen/qwen3.8-27b
EXECUTOR_MODEL=openai/gpt-oss-120b
EXECUTOR_FALLBACK=openai/gpt-oss-20b
VERIFIER_MODEL=openai/gpt-oss-20b
MAX_TOKENS=2048
MAX_STEPS=12
TAVILY_API_KEY=
# ;-separated dirs the agent may read (default: data/inbox only).
# Needs backend restart. Secrets (.env, *.pem/*.key, *id_rsa*) stay blocked.
# FILE_ROOTS=D:/documents/Projects

DB_HOST=
DB_PORT=17886
DB_NAME=centralign
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true
